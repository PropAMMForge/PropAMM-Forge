{
  "name": "propamm-forge",
  "version": "0.0.0",
  "private": true,
  "description": "Builder and SDK for deploying your own proprietary AMM on Solana",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "sync:idl": "node scripts/sync-idl.mjs",
    "check:idl": "node scripts/sync-idl.mjs --check",
    "gate": "pnpm check:idl && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
