# PropAMM Forge — example environment. Copy to .env and put the real values there.
# .env is in .gitignore. No key from here may ever end up in git.

# ── Network ──────────────────────────────────────────────────────────────────
# The local network is for measurements. SC-003 (an update within 2 slots) is
# measured right here: devnet has different latencies and runs into the RPC quota.
SOLANA_CLUSTER=localnet
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_WS_URL=ws://127.0.0.1:8900

# Devnet — demo windows only. At a 5 s tick that is ≈31 000 calls/day out of a
# free budget of 33 000; a 1 s tick does not fit the free limit.
# DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=REPLACE_ME

# ── Keys ─────────────────────────────────────────────────────────────────────
# Three DIFFERENT keys. That is not caution but the FR-010 requirement: a
# compromised hot key grants the right to post a bad quote within max_size_base,
# but not to withdraw capital.
#
# owner — cold, NEVER appears on the engine host
VAULT_OWNER_KEYPAIR=/path/to/owner.json
# pricing_authority — hot, lives next to the engine
PRICING_AUTHORITY_KEYPAIR=/path/to/pricing.json
# halt_authority — with the operator
HALT_AUTHORITY_KEYPAIR=/path/to/halt.json

# ── Price feed ───────────────────────────────────────────────────────────────
# Since the Pyth Core upgrade (2026-08-26) Hermes needs an API key: without one
# every /v2/updates/* route answers 401. The key is a bearer token; a free trial
# comes with a Pyth Terminal sign-up. The old hermes.pyth.network host redirects
# to the same backend and needs the same key.
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_API_KEY=REPLACE_ME
# Base asset in USD (e.g. SOL/USD). 32 bytes as hex, with or without 0x.
PYTH_PRICE_FEED_ID=REPLACE_ME
# Quote asset in USD (e.g. USDC/USD). Leave empty to take the quote asset at par
# with USD — a choice about the stablecoin, made per deployment, not by the code.
PYTH_QUOTE_PRICE_FEED_ID=
# A value with a stale timestamp or a wider confidence interval is discarded by
# the engine, which clears the quote rather than repeating the last known one (FR-012, FR-014).
FEED_MAX_AGE_SECONDS=5
FEED_MAX_CONF_BPS=30

# ── Quote update rule (FR-011) ───────────────────────────────────────────────
# A hybrid: on deviation above the threshold, but no less often than the heartbeat tick.
QUOTE_DEVIATION_THRESHOLD_BPS=5
QUOTE_HEARTBEAT_SLOTS=12
# The tick must be SHORTER than the freshness limit, otherwise the AMM silently
# disappears from routes. A config where that is not so is refused by the engine at start (FR-011a).
QUOTE_MAX_AGE_SLOTS=25

# ── Risk (FR-025) ────────────────────────────────────────────────────────────
RISK_MAX_SKEW_BPS=2000
RISK_DAILY_LOSS_LIMIT=1000000
RISK_MODEL_TIMEOUT_MS=50

# ── Console ──────────────────────────────────────────────────────────────────
# Runtime goes through the pooler on 6543. The direct connection on 5432 is
# IPv6-only; migrations go through the session pooler. Role postgres, not anon.
DATABASE_URL=postgresql://postgres:REPLACE_ME@REPLACE_ME.pooler.supabase.com:6543/postgres
MIGRATION_DATABASE_URL=postgresql://postgres:REPLACE_ME@REPLACE_ME.pooler.supabase.com:5432/postgres

# Secret for signing session cookies. Generate: openssl rand -base64 32
SESSION_SECRET=REPLACE_ME
SESSION_TTL_MINUTES=60

API_PORT=8879
API_LOG_LEVEL=info
VITE_API_URL=http://localhost:8879
